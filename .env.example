# ═══════════════════════════════════════════
# Director Workflow — 环境变量模板
# ═══════════════════════════════════════════

# ─── 应用 ───
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# ─── 数据库 ───
DATABASE_URL=postgresql+asyncpg://director:director_pass@localhost:5432/director_db
REDIS_URL=redis://localhost:6379/0

# ─── 对象存储 (S3/R2) ───
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=director-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1

# ─── LLM ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
QWEN_API_KEY=
QWEN_MODEL=qwen-2.5-72b

# ─── 图像生成 ───
COMFYUI_URL=http://localhost:8188

# ─── 视频生成 ───
KLING_API_KEY=
KLING_API_SECRET=
SEEDANCE_API_KEY=
RUNWAY_API_KEY=

# ─── TTS 配音 ───
COSYVOICE_URL=http://localhost:9880
ELEVENLABS_API_KEY=

# ─── BGM / SFX ───
STABLE_AUDIO_API_KEY=

# ─── 内容安全 ───
NSFW_THRESHOLD=0.8
CONTENT_FILTER_ENABLED=true

# ─── 监控 ───
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=director-workflow
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── 认证 ───
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── 前端 (Vite) ───
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
